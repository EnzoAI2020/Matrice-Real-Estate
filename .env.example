# --- Form contatti (Google Apps Script) ---------------------------------
# URL /exec della distribuzione "App web" dello script in apps-script/.
VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/XXXX/exec

# --- Feed idealista/tools: FTP ------------------------------------------
# Credenziali fornite da idealista per questo destino.
# Servono SOLO alla sincronizzazione lato server (GitHub Actions o locale):
# non sono mai lette dal browser e non entrano nel bundle.
# Lasciare vuoti i valori in questo file: e' un modello, non un segreto.
IDEALISTA_FTP_HOST=ftp.habitania.com
IDEALISTA_FTP_PORT=21
IDEALISTA_FTP_USER=
IDEALISTA_FTP_PASSWORD=
IDEALISTA_FTP_PATH=/
# Facoltativo: forza il nome del file remoto se la scelta automatica e' ambigua.
IDEALISTA_FTP_FILE=
# Interruttore generale: "false" blocca ogni sincronizzazione.
IDEALISTA_SYNC_ENABLED=true

# --- Feed idealista/tools: destinazione Cloudflare D1 --------------------
# Usati dalla sincronizzazione per scrivere su D1 via API REST.
# Il token va creato con permesso "D1: Edit" sul solo database interessato.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# --- Sviluppo locale -----------------------------------------------------
# Se valorizzato, sincronizzazione e sito leggono/scrivono questo file SQLite
# invece di D1. Comodo in locale, da non impostare in produzione.
IDEALISTA_DB_FILE=
